SELECT nome, salario
FROM funcionarios
WHERE salario > 3000;


SELECT * 
FROM funcionarios
ORDER BY nome ASC;

SELECT 
    COUNT(*) AS total_funcionarios,
    AVG(salario) AS media_salarial,
    SUM(salario) AS soma_salarial
FROM funcionarios;

SELECT 
    departamento,
    COUNT(*) AS quantidade_funcionarios,
    AVG(salario) AS media_salarial
FROM funcionarios
GROUP BY departamento
HAVING COUNT(*) > 3;

SELECT nome, salario
FROM funcionarios
WHERE salario > (
    SELECT AVG(salario)
    FROM funcionarios
);

SELECT e.nome AS funcionario, d.nome AS departamento
FROM departamento e
INNER JOIN departamento d ON e.departamento_id = d.id;


SELECT e.nome AS funcionario, d.nome AS departamento
FROM Employees e
LEFT JOIN Departments d ON e.departamento_id = d.id;

SELECT * 
FROM Orders
