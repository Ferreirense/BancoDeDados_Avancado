SELECT * 
FROM Orders
WHERE YEAR(order_date) = 2025 AND MONTH(order_date) = 1;

SELECT nome AS Nome, salario AS Salario
FROM funcionarios;

SELECT f.nome, f.salario
FROM funcionarios f
WHERE f.salario > (
    SELECT AVG(f2.salario)
    FROM funcionarios f2
    WHERE f2.departamento_id = f.departamento_id
);







